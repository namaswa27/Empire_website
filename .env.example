# Copy to .env.local for local work, and set the same values in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# GitHub OAuth App used for admin login (github.com → Settings → Developer settings → OAuth Apps).
# Authorization callback URL: https://YOUR-SITE-DOMAIN/api/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Live site origin, no trailing slash. Must match config.yml base_url.
SITE_ORIGIN=https://YOUR-SITE-DOMAIN
